<?xml version="1.0" encoding="UTF-8" ?>
<lsccip:ip xmlns:lsccip="http://www.latticesemi.com/XMLSchema/Radiant/ip" xmlns:xi="http://www.w3.org/2001/XInclude" version="2.0" platform="Propel" platform_version="2026.1">
    <lsccip:general>
        <lsccip:vendor>custom</lsccip:vendor>
        <lsccip:library>module</lsccip:library>
        <lsccip:name>tts_apb</lsccip:name>
        <lsccip:display_name>TTS_APB</lsccip:display_name>
        <lsccip:version>2.0.0</lsccip:version>
        <lsccip:category>Custom IP</lsccip:category>
        <lsccip:keywords>tts, speech, formant, apb, pwm</lsccip:keywords>
        <lsccip:min_radiant_version>2025.2</lsccip:min_radiant_version>
        <lsccip:min_esi_version>2025.2</lsccip:min_esi_version>
        <lsccip:supported_products>
            <lsccip:supported_family name="LAV-AT" />
            <lsccip:supported_family name="LFCPNX" />
            <lsccip:supported_family name="LFD2NX" />
            <lsccip:supported_family name="LFMXO4" />
            <lsccip:supported_family name="LFMXO5" />
            <lsccip:supported_family name="LIFCL" />
            <lsccip:supported_family name="LN2-CT" />
        </lsccip:supported_products>
        <lsccip:supported_platforms>
            <lsccip:supported_platform name="esi" />
            <lsccip:supported_platform name="radiant" />
        </lsccip:supported_platforms>
    </lsccip:general>
    <lsccip:settings>
        <lsccip:setting id="__dummy__"
                        type="param"
                        value_type="string"
                        conn_mod="tts_apb_slave"
                        hidden="True"
         />
    </lsccip:settings>
    <lsccip:ports>
        <lsccip:port name="PCLK"
                     dir="in"
                     conn_mod="tts_apb_slave"
         />
        <lsccip:port name="TTS_CLK"
                     dir="in"
                     conn_mod="tts_apb_slave"
         />
        <lsccip:port name="RST_N"
                     dir="in"
                     conn_mod="tts_apb_slave"
         />
        <lsccip:port name="PADDR"
                     dir="in"
                     conn_mod="tts_apb_slave"
                     range="(3,0)"
                     bus_interface="APB_S0"
         />
        <lsccip:port name="PSEL"
                     dir="in"
                     conn_mod="tts_apb_slave"
                     bus_interface="APB_S0"
         />
        <lsccip:port name="PENABLE"
                     dir="in"
                     conn_mod="tts_apb_slave"
                     bus_interface="APB_S0"
         />
        <lsccip:port name="PWRITE"
                     dir="in"
                     conn_mod="tts_apb_slave"
                     bus_interface="APB_S0"
         />
        <lsccip:port name="PWDATA"
                     dir="in"
                     conn_mod="tts_apb_slave"
                     range="(31,0)"
                     bus_interface="APB_S0"
         />
        <lsccip:port name="PRDATA"
                     dir="out"
                     conn_mod="tts_apb_slave"
                     range="(31,0)"
                     bus_interface="APB_S0"
         />
        <lsccip:port name="PREADY"
                     dir="out"
                     conn_mod="tts_apb_slave"
                     bus_interface="APB_S0"
         />
        <lsccip:port name="PSLVERR"
                     dir="out"
                     conn_mod="tts_apb_slave"
                     bus_interface="APB_S0"
         />
        <lsccip:port name="PWM_OUT"
                     dir="out"
                     conn_mod="tts_apb_slave"
         />
    </lsccip:ports>
    <lsccip:outFileConfigs>
        <lsccip:fileConfig name="wrapper" rtl_seq="tts_apb.v;ttscpu.v;tts_roms.v;sample_fifo.v;tts_engine.v;pwm10.v;line_buf.v" />
    </lsccip:outFileConfigs>
    <xi:include parse="xml" href="bus_interface.xml" />
    <xi:include parse="xml" href="memory_map.xml" />
</lsccip:ip>

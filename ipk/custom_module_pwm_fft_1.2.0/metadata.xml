<?xml version="1.0" encoding="UTF-8" ?>
<lsccip:ip xmlns:lsccip="http://www.latticesemi.com/XMLSchema/Radiant/ip" xmlns:xi="http://www.w3.org/2001/XInclude" version="2.0" platform="Propel" platform_version="2026.1">
    <lsccip:general>
        <lsccip:vendor>custom</lsccip:vendor>
        <lsccip:library>module</lsccip:library>
        <lsccip:name>pwm_fft</lsccip:name>
        <lsccip:display_name>PWM_FFT</lsccip:display_name>
        <lsccip:version>1.2.0</lsccip:version>
        <lsccip:category>Custom IP</lsccip:category>
        <lsccip:keywords>pwm, audio, fft, spectrum, analyser, equalizer, bands, apb</lsccip:keywords>
        <lsccip:min_radiant_version>2026.1</lsccip:min_radiant_version>
        <lsccip:min_esi_version>2026.1</lsccip:min_esi_version>
        <lsccip:supported_products>
            <lsccip:supported_family name="LAV-AT" />
            <lsccip:supported_family name="LFCPNX" />
            <lsccip:supported_family name="LFD2NX" />
            <lsccip:supported_family name="LFMXO4" />
            <lsccip:supported_family name="LFMXO5" />
            <lsccip:supported_family name="LIFCL" />
        </lsccip:supported_products>
        <lsccip:supported_platforms>
            <lsccip:supported_platform name="esi" />
            <lsccip:supported_platform name="radiant" />
        </lsccip:supported_platforms>
    </lsccip:general>
    <lsccip:settings>
        <lsccip:setting id="WIN_CLKS"
                        type="param"
                        value_type="int"
                        conn_mod="pwm_fft"
                        title="CORE_CLK cycles per audio sample (CORE_CLK / sample rate; 1500 = 24 MHz / 16 kHz)"
                        default="1500"
                        value_range="(64, 4095)"
                        group1="General"
         />
    </lsccip:settings>
    <lsccip:ports>
        <lsccip:port name="CORE_CLK" dir="in" conn_mod="pwm_fft" />
        <lsccip:port name="PCLK"    dir="in"  conn_mod="pwm_fft" />
        <lsccip:port name="PRESETN" dir="in"  conn_mod="pwm_fft" />
        <lsccip:port name="PADDR"   dir="in"  conn_mod="pwm_fft" range="(9,0)"  bus_interface="APB_S0" />
        <lsccip:port name="PSEL"    dir="in"  conn_mod="pwm_fft" bus_interface="APB_S0" />
        <lsccip:port name="PENABLE" dir="in"  conn_mod="pwm_fft" bus_interface="APB_S0" />
        <lsccip:port name="PWRITE"  dir="in"  conn_mod="pwm_fft" bus_interface="APB_S0" />
        <lsccip:port name="PWDATA"  dir="in"  conn_mod="pwm_fft" range="(31,0)" bus_interface="APB_S0" />
        <lsccip:port name="PRDATA"  dir="out" conn_mod="pwm_fft" range="(31,0)" bus_interface="APB_S0" />
        <lsccip:port name="PREADY"  dir="out" conn_mod="pwm_fft" bus_interface="APB_S0" />
        <lsccip:port name="PSLVERR" dir="out" conn_mod="pwm_fft" bus_interface="APB_S0" />
        <lsccip:port name="PWM_IN"  dir="in"  conn_mod="pwm_fft" />
    </lsccip:ports>
    <lsccip:outFileConfigs>
        <lsccip:fileConfig name="wrapper" rtl_seq="pwm_fft.v" />
    </lsccip:outFileConfigs>
    <xi:include parse="xml" href="bus_interface.xml" />
    <xi:include parse="xml" href="memory_map.xml" />
</lsccip:ip>

<?xml version="1.0" encoding="UTF-8" ?>
<lsccip:ip xmlns:lsccip="http://www.latticesemi.com/XMLSchema/Radiant/ip" xmlns:xi="http://www.w3.org/2001/XInclude" version="2.0" platform="Propel" platform_version="2026.1">
    <lsccip:general>
        <lsccip:vendor>custom</lsccip:vendor>
        <lsccip:library>module</lsccip:library>
        <lsccip:name>mkr_rgb_spi</lsccip:name>
        <lsccip:display_name>MKR_RGB_SPI</lsccip:display_name>
        <lsccip:version>1.0.0</lsccip:version>
        <lsccip:category>Custom IP</lsccip:category>
        <lsccip:keywords>apa102, rgb, led, matrix, mkr rgb shield, spi, apb</lsccip:keywords>
        <lsccip:min_radiant_version>2026.1</lsccip:min_radiant_version>
        <lsccip:min_esi_version>2026.1</lsccip:min_esi_version>
        <lsccip:supported_products>
            <lsccip:supported_family name="LAV-AT" />
            <lsccip:supported_family name="LFCPNX" />
            <lsccip:supported_family name="LFD2NX" />
            <lsccip:supported_family name="LFMXO4" />
            <lsccip:supported_family name="LFMXO5" />
            <lsccip:supported_family name="LIFCL" />
        </lsccip:supported_products>
        <lsccip:supported_platforms>
            <lsccip:supported_platform name="esi" />
            <lsccip:supported_platform name="radiant" />
        </lsccip:supported_platforms>
    </lsccip:general>
    <lsccip:settings>
        <lsccip:setting id="NUM_LEDS"
                        type="param"
                        value_type="int"
                        conn_mod="mkr_rgb_spi"
                        title="Number of APA102 LEDs in the chain (CKI = PCLK / 2)"
                        default="84"
                        value_range="(1, 125)"
                        group1="General"
         />
    </lsccip:settings>
    <lsccip:ports>
        <lsccip:port name="PCLK"    dir="in"  conn_mod="mkr_rgb_spi" />
        <lsccip:port name="PRESETN" dir="in"  conn_mod="mkr_rgb_spi" />
        <lsccip:port name="PADDR"   dir="in"  conn_mod="mkr_rgb_spi" range="(9,0)"  bus_interface="APB_S0" />
        <lsccip:port name="PSEL"    dir="in"  conn_mod="mkr_rgb_spi" bus_interface="APB_S0" />
        <lsccip:port name="PENABLE" dir="in"  conn_mod="mkr_rgb_spi" bus_interface="APB_S0" />
        <lsccip:port name="PWRITE"  dir="in"  conn_mod="mkr_rgb_spi" bus_interface="APB_S0" />
        <lsccip:port name="PWDATA"  dir="in"  conn_mod="mkr_rgb_spi" range="(31,0)" bus_interface="APB_S0" />
        <lsccip:port name="PRDATA"  dir="out" conn_mod="mkr_rgb_spi" range="(31,0)" bus_interface="APB_S0" />
        <lsccip:port name="PREADY"  dir="out" conn_mod="mkr_rgb_spi" bus_interface="APB_S0" />
        <lsccip:port name="PSLVERR" dir="out" conn_mod="mkr_rgb_spi" bus_interface="APB_S0" />
        <lsccip:port name="LED_SDI" dir="out" conn_mod="mkr_rgb_spi" />
        <lsccip:port name="LED_CKI" dir="out" conn_mod="mkr_rgb_spi" />
    </lsccip:ports>
    <lsccip:outFileConfigs>
        <lsccip:fileConfig name="wrapper" rtl_seq="mkr_rgb_spi.v" />
    </lsccip:outFileConfigs>
    <xi:include parse="xml" href="bus_interface.xml" />
    <xi:include parse="xml" href="memory_map.xml" />
</lsccip:ip>
